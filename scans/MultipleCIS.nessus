<cm:compliance-check-id>297502b9c504c8c6dec1dbc6e9e2fe67a007462142e80725db2725a4db47a47a</cm:compliance-check-id>
<cm:compliance-actual-value>Compliant file(s):
      /etc/passwd - regex &apos;^root:&apos; found - expect &apos;^root:x:0:0:&apos; found in the following lines:
          1: root:x:0:0:root:/root:/bin/bash</cm:compliance-actual-value>
<cm:compliance-source>custom</cm:compliance-source>
