<cm:compliance-check-id>0a9b51fcefe3cfd3490239694db885108105d49ad092a6ee6c10999c3d155fc6</cm:compliance-check-id>
<cm:compliance-actual-value>The command &apos;echo &apos;Username, Current Days, Last Password Change Days&apos;; output=&quot;&quot;; failures=0; for i in $(cut -d: -f1 &lt; /etc/shadow); do now=$(($(date +%s) / 86400)); change_date=$(chage --list &quot;$i&quot; | grep &apos;Last password change&apos; | cut -d: -f2 | awk &apos;{$1=$1};1&apos;); if [[ $change_date != &quot;never&quot; ]]; then epoch_change_date=$(($(date -d &quot;${change_date}&quot; +%s) / 86400)); else epoch_change_date=&apos;Never&apos;; fi; output=&quot;${i}, ${now}, ${epoch_change_date}&quot;; if [[ $epoch_change_date -le $now ]]; then output=&quot;${output} - Pass&quot;; else output=&quot;${output} - Fail&quot;; ((failures++)); fi; echo &quot;${output}&quot;; done; echo &quot;Number of failures: ${failures}&quot;&apos; returned : 

