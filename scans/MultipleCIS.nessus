<cm:compliance-check-name>4.1.4.10 Ensure audit tools belong to group root</cm:compliance-check-name>
<cm:compliance-check-id>061930de6eab28c3271b4fd7dcda8590efeadaef303620a29a83ce0c2da429b1</cm:compliance-check-id>
<cm:compliance-source>custom</cm:compliance-source>
