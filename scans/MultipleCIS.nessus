<cm:compliance-check-name>2.2.1 Ensure &apos;Access Credential Manager as a trusted caller&apos; is set to &apos;No One&apos;</cm:compliance-check-name>
<cm:compliance-check-id>5aa5dc5fc9c70b64afb548928fc318041acc1b58f4de682398412283161f9cf0</cm:compliance-check-id>
<cm:compliance-actual-value>NULL</cm:compliance-actual-value>
<cm:compliance-source>custom</cm:compliance-source>
