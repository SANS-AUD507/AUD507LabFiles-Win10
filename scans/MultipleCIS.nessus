<cm:compliance-check-name>5.2.17 Ensure SSH warning banner is configured</cm:compliance-check-name>
<cm:compliance-check-id>52883f3ddf5965e28e6aab35324d66a971a71ba9ec63b9cfc5ff8bf2317f4733</cm:compliance-check-id>
<cm:compliance-actual-value>The file &quot;/etc/ssh/sshd_config&quot; does not contain &quot;^[\s]*[Bb]anner[\s]&quot;</cm:compliance-actual-value>
