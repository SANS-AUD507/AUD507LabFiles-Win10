<cm:compliance-check-name>5.7 Ensure &apos;Infrared monitor service (irmon)&apos; is set to &apos;Disabled&apos; or &apos;Not Installed&apos;</cm:compliance-check-name>
<cm:compliance-check-id>d24372afc2ea9a0a90f0f9e17cd3886f3b5ee2d82ead538c3561bd01f02706e1</cm:compliance-check-id>
<cm:compliance-actual-value>PASSED</cm:compliance-actual-value>
