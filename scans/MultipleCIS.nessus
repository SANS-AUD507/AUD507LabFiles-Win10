          1: root:$6$71XokXDAy41xmzCT$Konb.ljHhQAhtffkrZC/T8QSutmnuYd9.c0PULsED0Zgj4SV2We3TR7ldOeBgj03/Mo5wBpjXe12GPxvM2nWb0::0:99999:7:::
