<cm:compliance-check-name>3.3.5 Ensure broadcast ICMP requests are ignored - sysctl exec</cm:compliance-check-name>
<cm:compliance-check-id>80ef6bacb6d13b3bdfc43dcb151d028e565bcd569176d98d1ec9e621c0752255</cm:compliance-check-id>
<cm:compliance-source>custom</cm:compliance-source>
