<cm:compliance-actual-value>The file /etc/crontab with fmode owner: root group: root mode: 0644 uid: 0 gid: 0 uneven permissions : FALSE  does not match the policy value owner: root group: root mask: 077 uneven permissions : FALSE 

/etc/crontab</cm:compliance-actual-value>
<cm:compliance-source>custom</cm:compliance-source>
<cm:compliance-audit-file>CIS_Distribution_Independent_Linux_Server_L1_v2.0.0.audit</cm:compliance-audit-file>
