<cm:compliance-check-name>3.5.3.1.3 Ensure ufw is uninstalled or disabled with iptables</cm:compliance-check-name>
<cm:compliance-check-id>2e87352110a62b87a4bd2fe0ebb827205211cbf7028184fee42d419a0f5e272b</cm:compliance-check-id>
<cm:compliance-source>custom</cm:compliance-source>
