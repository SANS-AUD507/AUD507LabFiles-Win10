<cm:compliance-check-name>5.28 Ensure &apos;Simple TCP/IP Services (simptcp)&apos; is set to &apos;Disabled&apos; or &apos;Not Installed&apos;</cm:compliance-check-name>
<cm:compliance-check-id>c8b8e60cc5847d6bbaacb50a59c5cdbdd706d69fb8167e61366c8e5a0372066c</cm:compliance-check-id>
<cm:compliance-actual-value>NULL</cm:compliance-actual-value>
