<cm:compliance-check-name>2.2.11 Ensure Samba is not installed</cm:compliance-check-name>
<cm:compliance-check-id>02cff362e9827142a1f6c3efbf10367f1d8cae398eeefa81467d1e4e99c53f62</cm:compliance-check-id>
<cm:compliance-source>custom</cm:compliance-source>
