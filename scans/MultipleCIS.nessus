<cm:compliance-check-name>3.3.6 Ensure bogus ICMP responses are ignored - (sysctl.conf/sysctl.d)</cm:compliance-check-name>
<cm:compliance-check-id>7500e5ce126fd1f93fdf7137ff10cfbf28de515051d4b0355bd1b5960aa255e1</cm:compliance-check-id>
<cm:compliance-actual-value>Compliant file(s):
      /etc/sysctl.conf - regex not found
      /etc/sysctl.d/10-console-messages.conf - regex not found
      /etc/sysctl.d/10-ipv6-privacy.conf - regex not found
      /etc/sysctl.d/10-kernel-hardening.conf - regex not found
      /etc/sysctl.d/10-magic-sysrq.conf - regex not found
      /etc/sysctl.d/10-network-security.conf - regex not found
      /etc/sysctl.d/10-ptrace.conf - regex not found
      /etc/sysctl.d/10-zeropage.conf - regex not found
      /etc/sysctl.d/99-sysctl.conf - regex not found
      /etc/ufw/sysctl.conf - regex &apos;icmp_ignore_bogus_error_responses&apos; found - expect &apos;^[\s]*(net\.ipv4\.|net/ipv4/)icmp_ignore_bogus_error_responses[\s]*=[\s]*1[\s]*&apos; found in the following lines:
          24: net/ipv4/icmp_ignore_bogus_error_responses=1
      /lib/sysctl.d/50-default.conf - regex not found
      /lib/sysctl.d/50-pid-max.conf - regex not found
      /lib/sysctl.d/99-protect-links.conf - regex not found
      /usr/lib/sysctl.d/50-default.conf - regex not found
      /usr/lib/sysctl.d/50-pid-max.conf - regex not found
