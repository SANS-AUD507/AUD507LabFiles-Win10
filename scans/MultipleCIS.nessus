<cm:compliance-check-id>63a35734faadacdcecb1f9c5f5f0564c4fb6ba894306fce393d4ead06e55ab93</cm:compliance-check-id>
<cm:compliance-actual-value>The file &quot;/etc/ssh/sshd_config&quot; does not contain &quot;^(?i)[\s]*ignorerhosts[\s](?-i)&quot;</cm:compliance-actual-value>
<cm:compliance-source>custom</cm:compliance-source>
<cm:compliance-audit-file>CIS_Distribution_Independent_Linux_Server_L1_v2.0.0.audit</cm:compliance-audit-file>
<cm:compliance-policy-value>expect: ^(?i)[\s]*ignorerhosts[\s]+no[\s]*$(?-i)
