<cm:compliance-check-name>5.3.5 Ensure re-authentication for privilege escalation is not disabled globally</cm:compliance-check-name>
<cm:compliance-check-id>79bc62e3d4765f291716e1a13f583b963bcd4815740e0f34cd6b3e86c05b4b53</cm:compliance-check-id>
<cm:compliance-source>custom</cm:compliance-source>
