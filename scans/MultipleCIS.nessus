<cm:compliance-check-name>18.10.29.3 Ensure &apos;Turn off heap termination on corruption&apos; is set to &apos;Disabled&apos;</cm:compliance-check-name>
<cm:compliance-check-id>0cb8d996a332c82c126d5fb6ab81a2ce155d349f3e5674066c38dac97e4c67d2</cm:compliance-check-id>
<cm:compliance-actual-value>NULL</cm:compliance-actual-value>
<cm:compliance-source>custom</cm:compliance-source>
