<cm:compliance-check-name>18.10.15.5 Ensure &apos;Enable OneSettings Auditing&apos; is set to &apos;Enabled&apos;</cm:compliance-check-name>
<cm:compliance-check-id>0b56f8134e8ba920dec6a1e2ff3b345ad920c65e2ee95760e9ea1fa77b976585</cm:compliance-check-id>
<cm:compliance-actual-value>NULL</cm:compliance-actual-value>
<cm:compliance-source>custom</cm:compliance-source>
