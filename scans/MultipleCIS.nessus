<cm:compliance-check-name>2.2.3 Ensure CUPS is not installed</cm:compliance-check-name>
<cm:compliance-check-id>2bfa8a6ed4b43c9ccffb41cb9fedb252fc899284ccc2159a2ea5e574317422a2</cm:compliance-check-id>
<cm:compliance-source>custom</cm:compliance-source>
