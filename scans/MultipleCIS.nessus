<cm:compliance-check-name>5.2.7 Ensure SSH root login is disabled</cm:compliance-check-name>
<cm:compliance-check-id>3796c73b926563e610c5ab343a3ab11dd935fdd37c9238674da515f482226007</cm:compliance-check-id>
<cm:compliance-actual-value>The file &quot;/etc/ssh/sshd_config&quot; does not contain &quot;^[\s]*[Pp]ermit[Rr]oot[Ll]ogin[\s]&quot;</cm:compliance-actual-value>
