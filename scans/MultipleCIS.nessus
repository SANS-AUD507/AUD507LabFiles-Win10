<cm:compliance-check-name>1.1.8.2 Ensure noexec option set on /dev/shm partition</cm:compliance-check-name>
<cm:compliance-check-id>96647821855be77a1b43b357e9419accd60a072b442c8c6737f70b8a9ad32444</cm:compliance-check-id>
<cm:compliance-source>custom</cm:compliance-source>
