<cm:compliance-check-name>5.3.2 Ensure sudo commands use pty</cm:compliance-check-name>
<cm:compliance-check-id>697491f3cd9599bf734f4ce8d6bd53798c5f77371359f3b29596829e7b8e6eb4</cm:compliance-check-id>
<cm:compliance-source>custom</cm:compliance-source>
<cm:compliance-audit-file>CIS_Ubuntu_22.04_LTS_v1.0.0_Server_L1.audit</cm:compliance-audit-file>
