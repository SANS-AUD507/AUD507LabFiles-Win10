<cm:compliance-check-name>18.9.27.5 Ensure &apos;Turn off app notifications on the lock screen&apos; is set to &apos;Enabled&apos;</cm:compliance-check-name>
<cm:compliance-check-id>93768dbc51a5e8652e83f7566319e028a92960b8ec037e13567719a9e0e571fc</cm:compliance-check-id>
