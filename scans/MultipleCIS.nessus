<cm:compliance-check-name>1.4.2 Ensure bootloader password is set</cm:compliance-check-name>
<cm:compliance-check-id>c7039b9273b3d9f72b31306da03ea3c7e8aea252927c913c077705f47f6a1c87</cm:compliance-check-id>
<cm:compliance-source>custom</cm:compliance-source>
