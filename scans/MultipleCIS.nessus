<cm:compliance-check-name>2.3.4 Ensure telnet client is not installed</cm:compliance-check-name>
<cm:compliance-check-id>9bc4090a3628bb647cbfe2c43c4311658d2a4784e494f235ae097a3ab641e372</cm:compliance-check-id>
