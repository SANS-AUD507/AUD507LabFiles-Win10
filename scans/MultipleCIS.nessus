<cm:compliance-check-name>18.10.4.1 Ensure &apos;Let Windows apps activate with voice while the system is locked&apos; is set to &apos;Enabled: Force Deny&apos;</cm:compliance-check-name>
<cm:compliance-check-id>c98352dd7a9e3291596a6880ea43ff06b69f83984874568a638d29a43e564c6c</cm:compliance-check-id>
<cm:compliance-actual-value>NULL</cm:compliance-actual-value>
<cm:compliance-source>custom</cm:compliance-source>
