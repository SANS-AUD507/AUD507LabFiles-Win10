<cm:compliance-check-name>18.4.3 Ensure &apos;Configure SMB v1 client driver&apos; is set to &apos;Enabled: Disable driver (recommended)&apos;</cm:compliance-check-name>
<cm:compliance-check-id>942a25ff4dfcd9625c266c15900e2177dd979739d6a95099b4ced6f4feaaa358</cm:compliance-check-id>
<cm:compliance-actual-value>NULL</cm:compliance-actual-value>
