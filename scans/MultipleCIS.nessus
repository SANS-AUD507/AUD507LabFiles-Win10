<cm:compliance-check-name>1.8.10 Ensure XDCMP is not enabled</cm:compliance-check-name>
<cm:compliance-check-id>f2aadfca94a924e8b775482b0c248ae52799f5168bbc871d8822b309d32ebec4</cm:compliance-check-id>
