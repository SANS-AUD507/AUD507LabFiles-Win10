<cm:compliance-check-name>5.31 Ensure &apos;SSDP Discovery (SSDPSRV)&apos; is set to &apos;Disabled&apos;</cm:compliance-check-name>
<cm:compliance-check-id>faca0bb771280efd1142f9f149948bde5f4dd70658d5eb056516c84f491a6848</cm:compliance-check-id>
<cm:compliance-actual-value>3</cm:compliance-actual-value>
